                      <a
                        href={`https://www.google.com/maps/search/?api=1&query=${item.lat},${item.lng}`}
                        target="_blank"
                        rel="noreferrer"
                        className="flex-1 py-2 border border-blue-500 text-blue-600 rounded-md text-xs font-semibold flex items-center justify-center gap-1 hover:bg-blue-50"
                      >
                        <Navigation className="w-3.5 h-3.5" /> Google Maps
                      </a>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>

      {/* MODAL LIGHTBOX SLIDER FOTO */}
      {previewModal.isOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 animate-in fade-in duration-150">
