<file path="backend/src/controller/adminController.js">
import { supabase, supabaseAdmin } from "../config/supabase.js";
import { HttpError, wrap } from "../utils/http.js";

// Helper penanganan error Supabase Auth
function errorAuth(error) {
  const pesan = (error.message || "").toLowerCase();
  if (error.status === 422 || pesan.includes("already")) {
    return new HttpError(409, "Email sudah terdaftar");
  }
  if (pesan.includes("password")) {
    return new HttpError(400, "Password tidak memenuhi syarat");
  }
  return error;
}

async function ambilAdmin(id) {
  const { data, error } = await supabaseAdmin
    .from("profiles")
    .select("id, name, email, role, region, is_active, must_change_password, created_at")
    .eq("id", id)
    .maybeSingle();

  if (error) throw error;
  if (!data) throw new HttpError(404, "Akun admin tidak ditemukan");
  return data;
}

// 1. Daftar seluruh akun admin (dengan pencarian nama/email/region)
export const listAdmin = wrap(async (req, res) => {
  const { q } = req.valid.query;

  let query = supabaseAdmin
    .from("profiles")
    .select("id, name, email, role, region, is_active, created_at")
    .order("created_at", { ascending: false });

  if (q) {
    const aman = q.replace(/[%_\\]/g, " ");
    query = query.or(`name.ilike.%${aman}%,email.ilike.%${aman}%,region.ilike.%${aman}%`);
  }

  const { data, error } = await query;
  if (error) throw error;

  res.json({ data });
});

// 2. Buat akun admin baru (oleh Superadmin)
export const createAdmin = wrap(async (req, res) => {
  const { name, email, password, region, role = "admin_wilayah" } = req.valid.body;

  // Gunakan supabaseAdmin (bukan supabase biasa)
  const { data: authData, error: authErr } = await supabaseAdmin.auth.admin.createUser({
    email,
    password,
    email_confirm: true,
  });

  if (authErr) throw errorAuth(authErr);

  // Simpan profil di tabel profiles pakai client biasa/admin
  const { error: errProfil } = await supabaseAdmin.from("profiles").insert({
    id: authData.user.id,
    name,
    email,
    region,
    role,
    is_active: true,
    must_change_password: true,
  });

  // Rollback pakai supabaseAdmin jika simpan profil gagal
  if (errProfil) {
    await supabaseAdmin.auth.admin.deleteUser(authData.user.id);
    throw errProfil;
  }

  res.status(201).json({
    message: "Akun admin berhasil dibuat",
    data: {
      id: authData.user.id,
      name,
      email,
      region,
      role,
      is_active: true,
    },
  });
});

// 3. Perbarui data admin / ubah status aktif
export const updateAdmin = wrap(async (req, res) => {
  const { id } = req.valid.params;
  const { name, email, region, role, is_active } = req.valid.body;

  await ambilAdmin(id); // Memastikan ID ada

  // Update email di Supabase Auth jika berubah
  if (email !== undefined) {
    const { error: errAuth } = await supabaseAdmin.auth.admin.updateUserById(id, {
      email,
      email_confirm: true,
    });
    if (errAuth) throw errorAuth(errAuth);
  }

  const ubahProfil = {};
  if (name !== undefined) ubahProfil.name = name;
  if (email !== undefined) ubahProfil.email = email;
  if (region !== undefined) ubahProfil.region = region;
  if (role !== undefined) ubahProfil.role = role;
  if (is_active !== undefined) ubahProfil.is_active = is_active;

  if (Object.keys(ubahProfil).length > 0) {
    const { error } = await supabaseAdmin.from("profiles").update(ubahProfil).eq("id", id);
    if (error) throw error;
  }

  res.json({
    message: "Data admin berhasil diperbarui",
    data: await ambilAdmin(id),
  });
});

// 4. Hapus akun admin
export const deleteAdmin = wrap(async (req, res) => {
  const { id } = req.valid.params;
  await ambilAdmin(id);

  const { error } = await supabaseAdmin.auth.admin.deleteUser(id); // Profil ikut terhapus otomatis (cascade)
  if (error) throw error;

  res.json({ message: "Akun admin berhasil dihapus" });
});
</file>

<file path="backend/src/controller/pospamController.js">
import { supabase, BUCKET_FOTO, supabaseAdmin } from "../config/supabase.js";
import { HttpError, wrap } from "../utils/http.js";
import { deteksiTipeGambar } from "../middleware/upload.js";

// Helper verifikasi hak akses wilayah
function pastikanAksesWilayah(reqUser, targetRegion) {
  if (reqUser.role !== "super_admin" && reqUser.region !== targetRegion) {
    throw new HttpError(403, "Anda tidak memiliki akses ke data wilayah ini");
  }
}

/* ------------------------------------------------------------------ */
/* Public & Peta                                                      */
/* ------------------------------------------------------------------ */

// Daftar pospam (dengan paginasi & pencarian)
export const listPospam = wrap(async (req, res) => {
  let { region, q, page = 1, limit = 10 } = req.valid.query;

  // Admin wilayah hanya boleh melihat wilayahnya sendiri
  if (req.user && req.user.role !== "super_admin") {
    region = req.user.region;
  }

  let query = supabaseAdmin
    .from("pospam")
    .select("*", { count: "exact" })
    .order("created_at", { ascending: false });

  if (region) query = query.eq("region", region);
  if (q) {
    const aman = q.replace(/[,()%*\\]/g, " ");
    query = query.or(`name.ilike.%${aman}%,location.ilike.%${aman}%`);
  }

  const dari = (page - 1) * limit;
  const { data, error, count } = await query.range(dari, dari + limit - 1);
  if (error) throw error;

  res.json({
    data,
    meta: { page: Number(page), limit: Number(limit), total: count ?? 0 },
  });
});

// Titik koordinat untuk visualisasi peta & Coverage Gap (ringan)
export const petaPospam = wrap(async (req, res) => {
  const { region } = req.valid.query;

  let query = supabaseAdmin
    .from("pospam")
    .select("id, name, region, location, latitude, longitude, facility, photo")
    .limit(1000);

  if (region) query = query.eq("region", region);

  const { data, error } = await query;
  if (error) throw error;

  res.json({ data });
});

// Detail single pospam
export const getPospam = wrap(async (req, res) => {
  const { id } = req.valid.params;

  const { data, error } = await supabaseAdmin
    .from("pospam")
    .select("*")
    .eq("id", id)
    .maybeSingle();

  if (error) throw error;
  if (!data) throw new HttpError(404, "Pospam tidak ditemukan");

  res.json({ data });
});

/* ------------------------------------------------------------------ */
/* Admin Management & Upload Foto                                     */
/* ------------------------------------------------------------------ */

// Unggah foto fasilitas ke Supabase Storage (Mengembalikan URL Publik)
export const uploadFotoPospam = wrap(async (req, res) => {
  if (!req.file) throw new HttpError(400, "Tidak ada berkas foto yang diunggah");

  const infoGambar = deteksiTipeGambar(req.file.buffer);
  if (!infoGambar) throw new HttpError(400, "Format gambar tidak valid atau korup");

  const namaFile = `pospam/${Date.now()}_${Math.random().toString(36).substring(2, 8)}.${infoGambar.ext}`;

  const { data: uploadData, error: uploadErr } = await supabaseAdmin.storage
    .from(BUCKET_FOTO || "pospam-photos")
    .upload(namaFile, req.file.buffer, {
      contentType: infoGambar.mime,
      upsert: false,
    });

  if (uploadErr) throw new HttpError(500, `Gagal upload foto: ${uploadErr.message}`);

  const { data: urlData } = supabaseAdmin.storage
    .from(BUCKET_FOTO || "pospam-photos")
    .getPublicUrl(uploadData.path);

  res.status(201).json({
    message: "Foto berhasil diunggah",
    url: urlData.publicUrl,
  });
});

export const createPospam = wrap(async (req, res) => {
  const body = req.valid.body;

  // Jika admin_wilayah, paksa region dari akun login
  if (req.user.role !== "super_admin") {
    body.region = req.user.region;
  }

  const { data, error } = await supabaseAdmin
    .from("pospam")
    .insert({
      ...body,
      user_id: req.user.id,
    })
    .select()
    .single();

  if (error) throw error;
  res.status(201).json({ message: "Pospam berhasil dibuat", data });
});

export const updatePospam = wrap(async (req, res) => {
  const { id } = req.valid.params;
  const body = req.valid.body;

  const { data: poslama } = await supabaseAdmin
    .from("pospam")
    .select("region")
    .eq("id", id)
    .maybeSingle();

  if (!poslama) throw new HttpError(404, "Pospam tidak ditemukan");
  pastikanAksesWilayah(req.user, poslama.region);

  const { data, error } = await supabaseAdmin
    .from("pospam")
    .update(body)
    .eq("id", id)
    .select()
    .single();

  if (error) throw error;
  res.json({ message: "Data pospam berhasil diperbarui", data });
});

export const deletePospam = wrap(async (req, res) => {
  const { id } = req.valid.params;

  const { data: poslama } = await supabaseAdmin
    .from("pospam")
    .select("region")
    .eq("id", id)
    .maybeSingle();

  if (!poslama) throw new HttpError(404, "Pospam tidak ditemukan");
  pastikanAksesWilayah(req.user, poslama.region);

  const { error } = await supabaseAdmin.from("pospam").delete().eq("id", id);
  if (error) throw error;

  res.json({ message: "Pospam berhasil dihapus" });
});
</file>

