<file path="frontend/src/app/admin/kelola-pospam/page.jsx">
"use client";

import { useState, useEffect } from "react";
import Image from "next/image"; // Tambahkan import Image
import { Plus, Camera, Trash2, X } from "lucide-react";
import RegionPicker, {
  EMPTY_REGION,
  formatRegion,
  regionToQueries,
} from "@/components/admin/RegionPicker";
import ConfirmDialog from "@/components/admin/ConfirmDialog";
import {
  getPospamsApi, 
  createPospam,
  updatePospam, 
  deletePospam,
  uploadFotoPospam,

} from "@/lib/api";
import MapPicker from "@/components/admin/MapPicker";
import { useAuth } from "@/hooks/useAuth";
import { getRegionScope } from "@/lib/regionScope";

const DEFAULT_FACILITIES = ["Toilet", "Mushola", "Medis", "Parkir Area", "Rest Area"];

const emptyForm = {
  name: "",
  coordinator: "",
  coordinatorPhone: "",
  region: EMPTY_REGION,
  street: "",
  lat: null,
  lng: null,
};

const defaultOptions = DEFAULT_FACILITIES.map((name) => ({ name, custom: false }));

const buildOptions = (extra = []) => [
  ...defaultOptions,
  ...[...new Set(extra)]
    .filter((n) => !DEFAULT_FACILITIES.includes(n))
    .map((name) => ({ name, custom: true })),
];

export default function KelolaPospamPage() {
  const [pospamList, setPospamList] = useState([]);
  const [loading, setLoading] = useState(true);
  const [mode, setMode] = useState(null); // null | "add" | "edit"
  const [selectedId, setSelectedId] = useState(null);
  const [currentArea, setCurrentArea] = useState("");

  const [form, setForm] = useState(emptyForm);
  const [photos, setPhotos] = useState([]); // { url, file } | null
  const [facilityOptions, setFacilityOptions] = useState(defaultOptions);
  const [facilities, setFacilities] = useState([]);
  const [addingFacility, setAddingFacility] = useState(false);
  const [newFacility, setNewFacility] = useState("");
  const [facilityError, setFacilityError] = useState("");

  const setField = (key) => (e) => setForm((f) => ({ ...f, [key]: e.target.value }));
  const [confirmOpen, setConfirmOpen] = useState(false);

  const focus = regionToQueries(form.region);

  const { profile } = useAuth();

  useEffect(() => {
  fetchPospam();
  // eslint-disable-next-line react-hooks/exhaustive-deps
}, [profile?.role, profile?.region]);

// Tambahkan state error di dalam komponen KelolaPospamPage
const [errorMessage, setErrorMessage] = useState("");

const fetchPospam = async () => {
  const scope = getRegionScope(profile);
  if (!scope.ready) return; // tunggu profil selesai dimuat

  if (scope.blocked) {
    setPospamList([]);
    setErrorMessage("Akun Anda belum memiliki wilayah. Hubungi super admin.");
    setLoading(false);
    return;
  }

  try {
    setLoading(true);
    setErrorMessage("");
    const response = await getPospamsApi(scope.params);
    const data = Array.isArray(response) ? response : response.data || [];
    setPospamList(data);
  } catch (error) {
    console.error("Gagal mengambil data Pospam:", error);
    setErrorMessage(error.message || "Gagal memuat data.");
    setPospamList([]);
  } finally {
    setLoading(false);
  }
};

  const allFacilityNames = pospamList.flatMap((p) => p.facility || []);
  // ---------- Buka form ----------
  const openAdd = () => {
    cancelAddFacility();
    setForm(emptyForm);
    setCurrentArea("");
    setPhotos([null]); 
    setFacilities([]);
    setFacilityOptions(buildOptions(allFacilityNames));
    setSelectedId(null);
    setMode("add");
  };

const openEdit = (item) => {
  cancelAddFacility();
  const itemFacilities = Array.isArray(item.facility) ? item.facility : [];

  setForm({
    name: item.name || "",
    coordinator: item.koor_name || "",
    coordinatorPhone: item.koor_phone || "",
    region: EMPTY_REGION,          // picker dikosongkan; alamat lama ditampilkan sebagai teks
    street: item.location || "",
    lat: item.latitude ?? null,
    lng: item.longitude ?? null,
  });
  setCurrentArea(item.area || item.region || ""); // state baru, lihat di bawah

  setPhotos(Array.isArray(item.photo) ? item.photo.map((url) => ({ url, file: null })) : []);
  setFacilities(itemFacilities);
  setFacilityOptions(buildOptions([...allFacilityNames, ...itemFacilities]));
  setSelectedId(item.id);
  setMode("edit");
};

  // ---------- Foto ----------
  const setPhoto = (index, file) => {
    if (!file) return;
    setPhotos((prev) =>
      prev.map((p, i) => (i === index ? { url: URL.createObjectURL(file), file } : p))
    );
  };
  const removePhoto = (index) =>
    setPhotos((prev) => prev.map((p, i) => (i === index ? null : p)));
  const addPhotoSlot = () => setPhotos((prev) => [...prev, null]);

  // ---------- Fasilitas ----------
  const toggleFacility = (name) =>
    setFacilities((prev) =>
      prev.includes(name) ? prev.filter((f) => f !== name) : [...prev, name]
    );

  const cancelAddFacility = () => {
    setAddingFacility(false);
    setNewFacility("");
    setFacilityError("");
  };

  const saveNewFacility = () => {
    const name = newFacility.trim();
    if (!name) return setFacilityError("Nama fasilitas tidak boleh kosong.");
    if (facilityOptions.some((o) => o.name.toLowerCase() === name.toLowerCase())) {
      return setFacilityError("Fasilitas sudah ada.");
    }
    setFacilityOptions((prev) => [...prev, { name, custom: true }]);
    setFacilities((prev) => [...prev, name]);
    cancelAddFacility();
  };

  const removeFacilityOption = (name) => {
    setFacilityOptions((prev) => prev.filter((o) => o.name !== name));
    setFacilities((prev) => prev.filter((f) => f !== name));
  };

  // ---------- Simpan & Hapus ----------
const handleSubmit = async (e) => {
  e.preventDefault();
  try {
    const photo = await Promise.all(
      photos.filter(Boolean).map((p) => (p.file ? uploadFotoPospam(p.file) : p.url))
    );

    if (form.lat == null || form.lng == null) {
      alert("Tentukan lokasi pospam pada peta (klik peta atau geser pin).");
      return;
    }

    const areaStr = formatRegion(form.region); // kosong jika belum dipilih

    const payload = {
      name: form.name,
      koor_name: form.coordinator,
      koor_phone: form.coordinatorPhone,
      location: form.street,
      latitude: Number(form.lat),
      longitude: Number(form.lng),
      facility: facilities,
      photo,
      ...(areaStr ? { area: areaStr } : {}),
    };

    if (mode === "add") {
      // region wajib lolos validasi; untuk admin_wilayah akan ditimpa BE dari akun login
      await createPospam({ ...payload, region: areaStr || "-" });
    } else {
      await updatePospam(selectedId, payload); // region sengaja tidak dikirim
    }

    await fetchPospam();
    setMode(null);
    setSelectedId(null);
  } catch (error) {
    console.error("Gagal menyimpan Pospam:", error);
    alert(`Gagal menyimpan: ${error.message}`);
  }
};

const handleDelete = async () => {
  if (!selectedId) return;
  try {
    await deletePospam(selectedId);
    await fetchPospam();
    setMode(null);
    setSelectedId(null);
  } catch (error) {
    alert(`Gagal menghapus: ${error.message}`);
  }
};

  const inputClass =
    "w-full border border-slate-200 rounded-md px-3 py-2 text-xs md:text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none focus:border-[#1a9fb8]";
  const labelClass = "block text-xs md:text-sm text-slate-600 font-medium mb-1.5";

  return (
    <div className="min-h-[calc(100vh-72px)] bg-[#eceef7] font-sans pb-10">
      <main className="w-[84%] mx-auto pt-5 space-y-4">
        {/* Judul */}
        <div className="flex items-start justify-between">
          <div className="flex items-center gap-3">
            {/* Ganti icon MapPin dengan Image at-icons_location.png */}
            <div className="w-17 h-17 relative shrink-0">
                <Image 
                    src="/icons_location.png" 
                    alt="Location Icon"
                    fill
                    className="object-contain"
                    />
            </div>
            <div>
              <h1 className="text-xl md:text-2xl font-bold text-slate-900 leading-tight">Kelola Pospam</h1>
              <p className="text-xs md:text-sm text-slate-600 font-medium mt-0.5">
                Kelola data, lokasi, dan fasilitas Pos Pengamanan pada wilayah Anda.
              </p>
            </div>
          </div>
          <button
            onClick={openAdd}
            className="bg-[#1a9fb8] hover:bg-[#158aa0] transition text-white text-xs font-bold px-4 py-2 rounded-md flex items-center gap-1.5 shadow-sm"
          >
            <Plus className="w-3.5 h-3.5" />
            Tambah Pospam
          </button>
        </div>

        <div className={mode ? "grid grid-cols-1 lg:grid-cols-2 gap-5 items-start" : ""}>
          {/* Daftar Nomor Darurat */}
          <div className="space-y-3">
            {loading && (
              <div className="py-45 text-center">
                <p className="text-sm md:text-base text-slate-500">Memuat data...</p>
              </div>
            )}
            {errorMessage && (
              <div className="py-45 text-center">
                <p className="text-sm md:text-base text-red-500">{errorMessage}</p>
              </div>
            )}
            {!loading && !errorMessage && pospamList.length === 0 && (
                <div className="py-45 text-center">
                  <p className="text-base md:text-lg font-semibold text-slate-600">Belum ada data pospam</p>
                  <p className="text-xs md:text-sm text-slate-500 mt-1">
                    Klik tombol "Tambah Pospam" untuk menambahkan data pertama.
                  </p>
                </div>
              )}

            {pospamList.map((item, index) => (
              <div
                key={item.id}
                onClick={() => openEdit(item)}
                className={`bg-white rounded-md shadow flex overflow-hidden cursor-pointer border-2 transition ${
                  selectedId === item.id ? "border-[#2563eb]" : "border-transparent hover:border-slate-200"
                }`}
              >
                <div className="bg-[#1a9fb8] text-white font-bold text-sm w-12 flex items-center justify-center shrink-0">
                  {index + 1}
                </div>
                <div className="px-4 py-3.5 space-y-1.5">
                  <h3 className="text-sm md:text-base font-semibold text-slate-900">
                    {item.name}{" "}
                    <span className="text-xs font-normal text-slate-600">({item.koor_phone})</span>
                  </h3>
                  <p className="text-xs md:text-sm text-slate-700">
                    {item.location}{item.area ? `, ${item.area}` : ""}
                  </p>
                  <div className="flex flex-wrap gap-2 pt-1">
                    {(item.facility || []).map((f) => (
                      <span
                        key={f}
                        className="border border-slate-400 rounded px-2.5 py-0.5 text-[11px] md:text-xs text-slate-700">
                        {f}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Form Tambah / Lihat & Edit */}
          {mode && (
            <form
              onSubmit={handleSubmit}
              className={`bg-white rounded-md p-5 space-y-4 ${
                mode === "edit" ? "border border-slate-400 shadow-sm" : "shadow-sm"
              }`}
            >
              <h2 className="text-sm md:text-base font-bold text-slate-800">
                {mode === "add" ? "Tambah Pospam" : "Lihat & Edit Pospam"}
              </h2>

              <div>
                <label className={labelClass}>Nama Pos</label>
                <input className={inputClass} placeholder="Pospam Simpang Pasar Sapi" value={form.name} onChange={setField("name")} required />
              </div>

              <div>
                <label className={labelClass}>Nama Kordinator</label>
                <input className={inputClass} placeholder="Andreas" value={form.coordinator} onChange={setField("coordinator")} required />
              </div>

              <div>
                <label className={labelClass}>Nomor Kontak Kordinator</label>
                <input
                  className={inputClass}
                  inputMode="numeric"
                  maxLength={15}
                  pattern="[0-9]{10,15}"
                  title="Nomor harus 10 sampai 15 angka"
                  placeholder="085234817293"
                  value={form.telephone}
                  onChange={(e) =>
                    setForm((f) => ({
                      ...f,
                      phone: e.target.value.replace(/\D/g, "").slice(0, 15),
                    }))
                  }
                  required
                />
              </div>

              <div>
                <label className={labelClass}>Kabupaten/Kota, Kecamatan</label>
                <RegionPicker
                  required={mode === "add" || !currentArea}
                  value={form.region}
                  onChange={(region) => setForm((f) => ({ ...f, region }))}
                />
                {mode === "edit" && currentArea && (
                  <p className="text-xs md:text-sm text-slate-600 mt-1.5">
                    Tersimpan: {currentArea} (pilih ulang hanya jika ingin mengubah)
                  </p>
                )}
              </div>

              <div>
                <label className={labelClass}>Nama Jalan / Titik KM / Patokan</label>
                <input className={inputClass} placeholder="Simpang utama Pasar Sapi" value={form.street} onChange={setField("street")} required />
              </div>

              {/* Peta */}
              <div>
                <label className={labelClass}>Titik Lokasi di Peta</label>
                <MapPicker
                  lat={form.lat}
                  lng={form.lng}
                  onChange={({ lat, lng }) => setForm((f) => ({ ...f, lat, lng }))}
                  focusQuery={focus.main}
                  focusFallback={focus.fallback}
                />
              </div>
              {/* Foto Fasilitas */}
              <div>
                <label className={labelClass}>Foto Fasilitas</label>
                <div className="flex flex-wrap gap-2">
                  {photos.map((p, i) =>
                    p ? (
                      <div key={i} className="relative w-[72px] h-[72px] rounded-md overflow-hidden border border-slate-200">
                        {/* eslint-disable-next-line @next/next/no-img-element */}
                        <img src={p.url} alt="" className="w-full h-full object-cover" />
                        <button
                          type="button"
                          onClick={() => removePhoto(i)}
                          className="absolute top-0.5 right-0.5 bg-black/60 text-white rounded-full p-0.5"
                          title="Hapus foto"
                        >
                          <X className="w-3 h-3" />
                        </button>
                      </div>
                    ) : (
                      <label
                        key={i}
                        className="w-[72px] h-[72px] border border-dashed border-slate-400 rounded-md flex items-center justify-center cursor-pointer"
                      >
                        <Camera className="w-3.5 h-3.5 text-slate-800" />
                        <input
                          type="file"
                          accept="image/*"
                          className="hidden"
                          onChange={(e) => setPhoto(i, e.target.files?.[0])}
                        />
                      </label>
                    )
                  )}
                  <button
                    type="button"
                    onClick={addPhotoSlot}
                    className="w-[72px] h-[72px] border border-dashed border-slate-400 rounded-md flex items-center justify-center text-slate-800 text-sm"
                  >
                    +
                  </button>
                </div>
              </div>

              {/* Fasilitas */}
              <div>
                <div className="flex items-center justify-between mb-2">
                  <label className="text-xs font-semibold text-slate-800">
                    Fasilitas
                  </label>

                  <button
                    type="button"
                    onClick={() => setAddingFacility(true)}
                    disabled={addingFacility}
                    className="bg-[#1a9fb8] hover:bg-[#158aa0] disabled:opacity-50 text-white text-xs font-bold px-4 py-1.5 rounded-md"
                  >
                    + Tambah
                  </button>
                </div>

                {/* Form tambah fasilitas - hanya muncul SATU kali */}
                {addingFacility && (
                  <div className="mt-3 mb-3">
                    <div className="flex items-center gap-2">
                      <input
                        autoFocus
                        value={newFacility}
                        onChange={(e) => {
                          setNewFacility(e.target.value);
                          setFacilityError("");
                        }}
                        onKeyDown={(e) => {
                          if (e.key === "Enter") {
                            e.preventDefault();
                            saveNewFacility();
                          }

                          if (e.key === "Escape") {
                            cancelAddFacility();
                          }
                        }}
                        placeholder="Nama fasilitas baru"
                        className="flex-1 min-w-0 border border-[#1a9fb8] rounded-md px-3 py-2 text-xs text-slate-700 placeholder:text-slate-400 focus:outline-none"
                      />

                      <button
                        type="button"
                        onClick={cancelAddFacility}
                        className="bg-[#d9444a] hover:bg-[#c23a40] transition text-white text-xs font-bold px-5 py-2 rounded-md"
                      >
                        Batal
                      </button>

                      <button
                        type="button"
                        onClick={saveNewFacility}
                        className="bg-[#fbbf24] hover:bg-[#f59e0b] transition text-slate-900 text-xs font-bold px-5 py-2 rounded-md"
                      >
                        Tambah
                      </button>
                    </div>

                    {facilityError && (
                      <p className="text-xs text-red-500 mt-1">
                        {facilityError}
                      </p>
                    )}
                  </div>
                )}

                {/* Daftar fasilitas */}
                <div className="space-y-3">
                  {facilityOptions.map(({ name, custom }) => (
                    <div
                      key={name}
                      className="flex items-center justify-between text-xs md:text-sm text-slate-600 font-medium"
                    >
                      <span>{name}</span>

                      <div className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={facilities.includes(name)}
                          onChange={() => toggleFacility(name)}
                          className="w-4 h-4 rounded cursor-pointer accent-blue-700"
                        />

                        {custom ? (
                          <button
                            type="button"
                            onClick={() => removeFacilityOption(name)}
                            className="text-red-500 hover:text-red-700"
                            title="Hapus fasilitas"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        ) : (
                          <span className="w-3.5" /> // ruang kosong agar checkbox sejajar dengan baris yang punya tong sampah
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                {/* Tombol Hapus & Simpan */}
                <div className="flex gap-3 mt-8">
                  <button
                    type="button"
                    onClick={() => setConfirmOpen(true)}
                    className="flex-1 bg-[#d9444a] hover:bg-[#c23a40] text-white text-xs font-bold py-2.5 rounded-md"
                  >
                    Hapus
                  </button>

                  <button
                    type="submit"
                    className="flex-1 bg-[#fbbf24] hover:bg-[#f59e0b] text-slate-900 text-xs font-bold py-2.5 rounded-md"
                  >
                    Simpan
                  </button>
                  <ConfirmDialog
                    open={confirmOpen}
                    onCancel={() => setConfirmOpen(false)}
                    onConfirm={async () => {
                      setConfirmOpen(false);
                      await handleDelete();
                    }}
                  />
                </div>
              </div>
            </form>
          )}
        </div>
      </main>
    </div>
  );
}
</file>

<file path="frontend/src/app/admin/dashboard/page.jsx">
"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import Image from "next/image";
import { getPospamsApi, getEmergencyApi } from "@/lib/api";
import { formatRegion } from "@/components/admin/RegionPicker";
import {
  MapPin,
  Phone,
  ChevronDown,
  Bath,
  Moon,
  Cross,
  ParkingCircle,
  Coffee,
  Check,
} from "lucide-react";
import { useAuth } from "@/hooks/useAuth";
import { getRegionScope } from "@/lib/regionScope";
import PhotoLightbox from "@/components/admin/PhotoLightbox";

const CATEGORIES = ["Bencana", "Medis", "BBM", "Bengkel", "Keamanan"];
const DEFAULT_FACILITIES = ["Toilet", "Mushola", "Medis", "Parkir Area", "Rest Area"];
const FACILITY_ICON = {
  Toilet: Bath,
  Mushola: Moon,
  Medis: Cross,
  "Parkir Area": ParkingCircle,
  "Rest Area": Coffee,
};

// ---------- Normalisasi data backend ----------
const normalizePospam = (p) => ({
  id: p.id,
  name: p.name || "",
  coordinator: p.koor_name || "",
  phone: p.koor_phone || "",
  address: [formatRegion(p.location), p.area].filter(Boolean).join(", "),
  lat: p.latitude ?? null,
  lng: p.longitude ?? null,
  facilities: Array.isArray(p.facility) ? p.facility : [],
  photos: Array.isArray(p.photo) ? p.photo : [],
});

const normalizeEmergency = (e) => ({
  id: e.id,
  name: e.agency_name || "",
  phone: e.telephone || "",
  address:
    e.address ||
    e.alamat ||
    [e.location, formatRegion(e.region), e.area].filter(Boolean).join(", "),
  category: e.category || "",
  icon: e.icon || "",
  lat: e.lat ?? e.latitude ?? null,
  lng: e.lng ?? e.longitude ?? null,
});

// ---------- Helper ----------
const toDMS = (deg, pos, neg) => {
  const abs = Math.abs(deg);
  const d = Math.floor(abs);
  const m = Math.floor((abs - d) * 60);
  const s = ((abs - d) * 60 - m) * 60;
  return `${d}°${String(m).padStart(2, "0")}'${s.toFixed(1)}"${deg >= 0 ? pos : neg}`;
};
const formatCoord = (lat, lng) =>
  lat == null || lng == null ? "-" : `${toDMS(lat, "N", "S")} ${toDMS(lng, "E", "W")}`;

// ---------- Komponen kecil ----------
function MapEmbed({ lat, lng }) {
  if (lat == null || lng == null) {
    return (
      <div className="h-[180px] rounded-lg bg-slate-100 flex items-center justify-center text-xs text-slate-400">
        Lokasi belum diatur
      </div>
    );
  }
  return (
    <div className="h-[180px] rounded-lg overflow-hidden border border-slate-200">
      <iframe
        title="Peta lokasi"
        className="w-full h-full"
        loading="lazy"
        src={`https://maps.google.com/maps?q=${lat},${lng}&z=15&output=embed`}
      />
    </div>
  );
}

function Row({ label, children }) {
  return (
    <div className="grid grid-cols-[110px_1fr] md:grid-cols-[130px_1fr] gap-1 text-xs md:text-sm">
      <span className="font-semibold text-slate-800">{label}</span>
      <span className="text-slate-600 font-medium">: {children}</span>
    </div>
  );
}

function ListItem({ title, address, contact, selected, onClick }) {
  return (
    <div
      onClick={onClick}
      className={`px-4 py-3 rounded-lg cursor-pointer transition shadow-sm ${
        selected ? "bg-[#1a9fb8] text-white" : "bg-[#a6e8fa] hover:bg-[#92e0f4] text-slate-900"
      }`}
    >
      <h3 className="font-bold text-xs md:text-sm mb-1">{title}</h3>
      <div className="text-xs space-y-1">
        <p className="flex items-center gap-2">
          <MapPin className="w-3.5 h-3.5 shrink-0" />
          <span>{address || "-"}</span>
        </p>
        <p className="flex items-center gap-2">
          <Phone className="w-3.5 h-3.5 shrink-0" />
          <span>{contact || "-"}</span>
        </p>
      </div>
    </div>
  );
}

function PageSize({ value, onChange }) {
  return (
    <div className="flex items-center justify-center gap-2 text-xs text-slate-600">
      <span>Tampilkan data</span>
      <div className="relative inline-block">
        <select
          value={value}
          onChange={(e) => onChange(e.target.value)}
          className="bg-white border border-slate-400 rounded-full px-3 py-1 pr-6 text-xs text-slate-700 appearance-none focus:outline-none cursor-pointer"
        >
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        <ChevronDown className="w-3 h-3 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500" />
      </div>
    </div>
  );
}

function EmptyDetail() {
  return (
    <div className="h-full min-h-[200px] flex flex-col items-center justify-center text-center gap-1">
      <p className="text-xs md:text-sm font-semibold text-slate-600">Tidak ada Detail Informasi Pengadu</p>
      <p className="text-xs text-slate-400">Pilih salah satu data pengaduan dari daftar</p>
    </div>
  );
}
